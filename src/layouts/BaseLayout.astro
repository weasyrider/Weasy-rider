---
const { lang = "fr", title = 'Weasy Rider', description = 'Accessoires intelligents pour motards.' } = Astro.props;
import '../styles/global.css';
const prefix = lang === 'fr' ? '' : '/' + lang;
const frenchPath = Astro.url.pathname.replace(/^\/(?:it|en)(?=\/|$)/, '') || '/';
---
<!doctype html>
<html lang={lang} translate={lang !== "fr" ? "no" : undefined} class={lang !== "fr" ? "notranslate" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Weasy Rider</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={prefix + "/"} aria-label={lang === "en" ? "Weasy Rider, home" : lang === "it" ? "Weasy Rider, home" : "Weasy Rider, accueil"}><img src="/images/logo-original.jpg" alt={lang === "en" ? "Weasy Rider — smart accessories for motorcyclists" : lang === "it" ? "Weasy Rider — accessori intelligenti per motociclisti" : "Weasy Rider — accessoires intelligents pour motards"} /></a>
      <button class="menu-toggle" aria-label={lang === "en" ? "Open menu" : lang === "it" ? "Apri il menu" : "Ouvrir le menu"} aria-expanded="false">☰</button>
      <nav class="main-nav" aria-label={lang === "en" ? "Main navigation" : lang === "it" ? "Navigazione principale" : "Navigation principale"}>
        <a href={prefix + "/"} class={Astro.url.pathname === (prefix + '/') ? 'active' : ''}>{lang === 'en' ? 'Home' : lang === 'it' ? 'Home' : 'Accueil'}</a><a href={prefix + "/produits/"}>{lang === 'en' ? 'Our products' : lang === 'it' ? 'I nostri prodotti' : 'Nos produits'}</a><a href={prefix + "/compatibilite/"}>{lang === 'en' ? 'Compatibility' : lang === 'it' ? 'Compatibilità' : 'Compatibilité'}</a><a href={prefix + "/installation/"}>{lang === 'en' ? 'Installation' : lang === 'it' ? 'Installazione' : 'Installation'}</a><a href={prefix + "/a-propos/"}>{lang === 'en' ? 'About us' : lang === 'it' ? 'Chi siamo' : 'À propos'}</a><a href={prefix + "/faq/"}>FAQ</a><a href={prefix + "/contact/"}>{lang === 'en' ? 'Contact' : lang === 'it' ? 'Contatti' : 'Contact'}</a>
      </nav><div class="languages"><a href={frenchPath} aria-label="Français">FR</a><span></span><a href={"/it" + frenchPath} aria-label="Italiano">IT</a><span></span><a href={"/en" + frenchPath} aria-label="English">EN</a></div>
    </header>
    <slot />
    <footer class="site-footer"><div class="footer-points"><div><span class="footer-icon">♧</span><p><b>{lang === 'en' ? 'Fast delivery' : lang === 'it' ? 'Spedizione rapida' : 'Livraison rapide'}</b><small>{lang === 'en' ? 'Ships from France' : lang === 'it' ? 'Spedizione dalla Francia' : 'Expédition depuis la France'}</small></p></div><div><span class="footer-icon">▤</span><p><b>{lang === 'en' ? 'Secure payment' : lang === 'it' ? 'Pagamento sicuro' : 'Paiement sécurisé'}</b><small>{lang === 'en' ? 'Card, PayPal…' : lang === 'it' ? 'Carta, PayPal…' : 'Carte bancaire, PayPal…'}</small></p></div><div><span class="footer-icon"><img src="/images/france.svg" alt="France" /></span><p><b>{lang === 'en' ? 'Made in France' : lang === 'it' ? 'Fabbricazione francese' : 'Fabrication française'}</b><small>{lang === 'en' ? 'The heart of the kit' : lang === 'it' ? 'Il cuore del kit' : 'Le cœur du kit'}</small></p></div><div><span class="footer-icon">⬡</span><p><b>{lang === 'en' ? 'Warranty' : lang === 'it' ? 'Garanzia' : 'Garantie'}</b><small>{lang === 'en' ? 'Weasy Rider support' : lang === 'it' ? 'Assistenza Weasy Rider' : 'Support Weasy Rider'}</small></p></div></div><img class="footer-logo" src="/images/logo-original.jpg" alt="Weasy Rider" /></footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.main-nav');
      toggle?.addEventListener('click', () => { const open = nav?.classList.toggle('open'); toggle?.setAttribute('aria-expanded', String(Boolean(open))); });
    </script>
  </body>
</html>


