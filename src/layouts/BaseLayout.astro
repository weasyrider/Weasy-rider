---
const { lang = "fr", title = 'Weasy Rider', description = 'Accessoires intelligents pour motards.' } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Weasy Rider</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={lang === "it" ? "/it/" : "/"} aria-label={lang === "it" ? "Weasy Rider, home" : "Weasy Rider, accueil"}><img src="/images/logo-original.jpg" alt={lang === "it" ? "Weasy Rider — accessori intelligenti per motociclisti" : "Weasy Rider — accessoires intelligents pour motards"} /></a>
      <button class="menu-toggle" aria-label={lang === "it" ? "Apri il menu" : "Ouvrir le menu"} aria-expanded="false">☰</button>
      <nav class="main-nav" aria-label={lang === "it" ? "Navigazione principale" : "Navigation principale"}>
        <a href={lang === "it" ? "/it/" : "/"} class={Astro.url.pathname === (lang === 'it' ? '/it/' : '/') ? 'active' : ''}>{lang === 'it' ? 'Home' : 'Accueil'}</a><a href="/produits/">{lang === 'it' ? 'I nostri prodotti' : 'Nos produits'}</a><a href="/compatibilite/">{lang === 'it' ? 'Compatibilità' : 'Compatibilité'}</a><a href="/installation/">{lang === 'it' ? 'Installazione' : 'Installation'}</a><a href="/a-propos/">{lang === 'it' ? 'Chi siamo' : 'À propos'}</a><a href="/faq/">FAQ</a><a href="/contact/">{lang === 'it' ? 'Contatti' : 'Contact'}</a>
      </nav><div class="languages"><a href="/" aria-label="Français">FR</a><span></span><a href="/it/" aria-label="Italiano">IT</a></div>
    </header>
    <slot />
    <footer class="site-footer"><div class="footer-points"><div><span class="footer-icon">♧</span><p><b>{lang === 'it' ? 'Spedizione rapida' : 'Livraison rapide'}</b><small>{lang === 'it' ? 'Spedizione dalla Francia' : 'Expédition depuis la France'}</small></p></div><div><span class="footer-icon">▤</span><p><b>{lang === 'it' ? 'Pagamento sicuro' : 'Paiement sécurisé'}</b><small>{lang === 'it' ? 'Carta, PayPal…' : 'Carte bancaire, PayPal…'}</small></p></div><div><span class="footer-icon"><img src="/images/france.svg" alt="France" /></span><p><b>{lang === 'it' ? 'Fabbricazione francese' : 'Fabrication française'}</b><small>{lang === 'it' ? 'Il cuore del kit' : 'Le cœur du kit'}</small></p></div><div><span class="footer-icon">⬡</span><p><b>{lang === 'it' ? 'Garanzia' : 'Garantie'}</b><small>{lang === 'it' ? 'Assistenza Weasy Rider' : 'Support Weasy Rider'}</small></p></div></div><img class="footer-logo" src="/images/logo-original.jpg" alt="Weasy Rider" /></footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.main-nav');
      toggle?.addEventListener('click', () => { const open = nav?.classList.toggle('open'); toggle?.setAttribute('aria-expanded', String(Boolean(open))); });
    </script>
  </body>
</html>


