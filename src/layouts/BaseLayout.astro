---
const { title = 'Weasy Rider', description = 'Accessoires intelligents pour motards.' } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Weasy Rider</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Weasy Rider, accueil"><img src="/images/logo-weasy-rider.png" alt="Weasy Rider — accessoires intelligents pour motards" /></a>
      <button class="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false">☰</button>
      <nav class="main-nav" aria-label="Navigation principale">
        <a href="/" class={Astro.url.pathname === '/' ? 'active' : ''}>Accueil</a><a href="/produits/">Nos produits</a><a href="/compatibilite/">Compatibilité</a><a href="/installation/">Installation</a><a href="/a-propos/">À propos</a><a href="/faq/">FAQ</a><a href="/contact/">Contact</a>
      </nav><div class="languages"><a href="/" aria-label="Français">FR</a><span></span><a href="/it/" aria-label="Italiano">IT</a></div>
    </header>
    <slot />
    <footer class="site-footer"><div class="footer-points"><div><span class="footer-icon">♧</span><p><b>Livraison rapide</b><small>Expédition depuis la France</small></p></div><div><span class="footer-icon">▤</span><p><b>Paiement sécurisé</b><small>Carte bancaire, PayPal…</small></p></div><div><span class="footer-icon">⌖</span><p><b>Fabrication française</b><small>Le cœur du kit</small></p></div><div><span class="footer-icon">⬡</span><p><b>Garantie</b><small>Support Weasy Rider</small></p></div></div><img class="footer-logo" src="/images/logo-weasy-rider.png" alt="Weasy Rider" /></footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.main-nav');
      toggle?.addEventListener('click', () => { const open = nav?.classList.toggle('open'); toggle?.setAttribute('aria-expanded', String(Boolean(open))); });
    </script>
  </body>
</html>

