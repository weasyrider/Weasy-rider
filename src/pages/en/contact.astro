---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout lang="en" title="Contact" description="Have a question? Our team is here to help.">
  <main><section class="page-intro"><h1 class="contact-title">Contact Weasy Rider</h1><p>Have a question? Our team is here to help.</p>
<p class="partner-note">Dealers and distributors can use the form below to ask about their trade terms.</p>
    </section>

    <section class="order-form" id="commande" aria-labelledby="order-form-title">
      <h2 id="order-form-title">Order your kit</h2>
      <p class="order-note">Fill in this form to order your kit. We’ll get back to you shortly to finalise your order.</p>
    <iframe
      src="https://tally.so/embed/BEpRoe"
      title="Contact Weasy Rider"
      loading="lazy"
      style="display: block; width: 100%; height: 700px; border: 0;"
    ></iframe>
    </section>

    <div class="page-space"></div>
  </main>
</BaseLayout>

<style>
  .page-intro .partner-note {
    color: #73e69c;
    font-size: 20px;
    display: grid;
    place-items: center;
    min-height: 6rem;
    margin: 0;
    text-align: center;
  }

  .page-intro .contact-title {
    font-size: clamp(32px, 4.4vw, 54px);
  }

  .order-note {
    color: #ff5959;
  }

  @media (prefers-reduced-motion: no-preference) {
    .order-note {
      animation: order-note-blink 1.5s ease-in-out 10;
    }
  }

  @keyframes order-note-blink {
    50% { opacity: .5; }
  }
</style>
