---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout lang="en" title="Contact" description="Have a question? Our team is here to help.">
  <main><section class="page-intro contact-intro"><h1 class="contact-title">Contact / Orders / Information</h1><p>Have a question? Our team is here to help.</p>
      <p class="order-note">Want to order a kit? Please fill in the contact form. We’ll get back to you very soon.</p>
      <p class="partner-note">Dealers and distributors, contact us to find out about your trade terms. The form is also available for your enquiries.</p>
    </section>

    <section class="order-form" aria-label="Contact and order form">
    <p class="payment-note">After you submit the form, we will get back to you very shortly and explain the payment options: PayPal, Wero or bank transfer.</p>
    <p class="privacy-note">Your data is used to answer your enquiry and prepare your order. Fields marked with an asterisk are required. See our privacy policy for retention periods and information about your rights. <a href="/en/confidentialite/">Privacy</a>.</p>
    <iframe id="commande"
      src="https://tally.so/embed/BEpRoe"
      title="Contact Weasy Rider"
      loading="lazy"
      style="display: block; width: 100%; height: 700px; border: 0;"
    ></iframe>
    </section>

    <div class="page-space"></div>
  </main>
</BaseLayout>

<style>
  .privacy-note { font-size: 14px; line-height: 1.6; margin: 0 0 24px; color: #d5d8da; }
  .privacy-note a { color: #73e69c; text-underline-offset: 3px; }
  .payment-note {
    margin: 0 0 20px;
    padding: 16px 20px;
    border-left: 3px solid #73e69c;
    background: #ffffff08;
    color: #fff;
    font-size: 16px;
    line-height: 1.6;
  }
  .page-intro.contact-intro {
    min-height: 0;
    padding-bottom: 32px;
  }

  .page-intro .partner-note {
    color: #73e69c;
    font-size: 20px;
    display: grid;
    place-items: center;
    min-height: 0;
    margin: 20px 0 0;
    text-align: center;
  }

  .page-intro .contact-title {
    font-size: clamp(32px, 4.4vw, 54px);
  }

  .order-note {
    color: #ff5959;
  }

  @media (prefers-reduced-motion: no-preference) {
    .order-note, .partner-note {
      animation: order-note-blink 1.5s ease-in-out 10;
    }
  }

  @keyframes order-note-blink {
    50% { opacity: .5; }
  }
</style>
