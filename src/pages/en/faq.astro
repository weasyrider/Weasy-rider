---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../../components/FaqList.astro';

const items = [
  {
    "question": "Why did Weasy Rider develop a kit specifically for Moto Guzzi motorcycles?",
    "answer": "We felt it was inconsistent for such beautiful motorcycles to lack a safety feature that we consider absolutely essential as standard equipment, when it is fitted to other models from the same brand. That observation inspired us to develop a dedicated hazard light kit for your Moto Guzzi.",
    "highlight": "absolutely essential",
    "href": null,
    "linkLabel": null
  },
  {
    "question": "Why are hazard lights compulsory on cars but not on motorcycles, when a motorcycle is much more vulnerable than a car, for example when stopping suddenly?",
    "answer": "In the European Union, cars and motorcycles follow separate type-approval rules. Regulation (EU) 2019/2144, particularly Annex II, sets the framework for cars. For motorcycles, lighting requirements are set out in Commission Delegated Regulation (EU) No 3/2014, Annex IX. Under this framework, hazard lights are compulsory on cars but remain optional equipment for L3e motorcycles.",
    "href": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32019R2144",
    "linkLabel": "Read : Regulation (EU) 2019/2144 — Annex II",
    "additionalLinks": [
      {
        "href": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32014R0003",
        "label": "Read : Commission Delegated Regulation (EU) No 3/2014 — Annex IX"
      }
    ]
  },
  {
    "question": "How do I order my kit?",
    "answer": "Fill in the contact form and tell us your motorcycle model. We’ll get back to you shortly to finalise your order.",
    "href": "/en/contact/#haut-de-page",
    "linkLabel": "Order or contact us"
  },
  {
    "question": "How much does the kit cost?",
    "answer": "The complete kit for the V100 Mandello or V100 Stelvio, including the hazard light indicator, retails for €95, plus shipping. See our products page for details.",
    "href": "/en/produits/",
    "linkLabel": "View the kits"
  },
  {
    "question": "Is my Moto Guzzi compatible?",
    "answer": "Kits are available for the V100 Mandello and V100 Stelvio. The V7 kit is in development. Contact us to check your particular model.",
    "href": "/en/compatibilite/",
    "linkLabel": "Check compatibility"
  },
  {
    "question": "Does the wiring need to be modified?",
    "answer": "The model-specific V100 Mandello and V100 Stelvio kits are plug and play and reversible. Installation leaves the motorcycle’s original wiring intact.",
    "href": "/en/installation/",
    "linkLabel": "Read the instructions"
  },
  {
    "question": "How do I switch the hazard lights on and off?",
    "answer": "Operate the left or right turn signal once, then quickly press the central turn signal cancel button. Repeat the sequence to switch the hazard lights off.",
    "href": "/en/",
    "linkLabel": "Try the demo on the home page"
  },
  {
    "question": "When must hazard lights be used in France?",
    "answer": "In France, Article R416-18 requires hazard lights when drivers are temporarily forced to travel at a greatly reduced speed and risk surprising other road users. In an unbroken line of traffic, this requirement applies only to the last vehicle.",
    "href": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000006842278",
    "linkLabel": "Read Article R416-18 on Légifrance"
  },
  {
    "question": "What rules apply to a dangerously immobilised vehicle in France?",
    "answer": "Article R416-19 requires hazard lights and a warning triangle when a vehicle stopped on the carriageway poses a danger. Paragraph III exempts motorised two-wheelers from that requirement. Paragraph II requires a high-visibility vest during an emergency stop under the conditions it specifies.",
    "href": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000030582704",
    "linkLabel": "Read Article R416-19"
  },
  {
    "question": "What happens when I use a turn signal?",
    "answer": "The hazard lights pause while the turn signal is in use and resume automatically when you cancel it.",
    "href": null,
    "linkLabel": null
  },
  {
    "question": "Where can I find installation manuals and videos?",
    "answer": "The Installation section contains PDF manuals, videos and their QR codes to guide you through fitting the kit.",
    "href": "/en/installation/",
    "linkLabel": "Open manuals and videos"
  },
  {
    "question": "Can the WAM be used on other brands?",
    "answer": "The WAM is available for motorcycles without hazard lights. Installation then requires modifying the electrical system and may involve adding a handlebar switch. Contact us about your motorcycle.",
    "href": "/en/contact/#haut-de-page",
    "linkLabel": "Ask us a question"
  }
];
---
<BaseLayout lang="en" title="FAQ" description="Answers to frequently asked questions about our products.">
  <main>
    <section class="page-intro faq-intro">
      <h1>FAQ</h1>
      <p>Answers to frequently asked questions about our products.</p>
    </section>
    <FaqList items={items} />
  </main>
</BaseLayout>

<style>
  .page-intro.faq-intro {
    min-height: 0;
    padding-bottom: 40px;
  }
</style>
