---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout lang="it" title="Contatti" description="Hai una domanda? Il nostro team è a tua disposizione.">
  <main><section class="page-intro"><h1 class="contact-title">Contatti Weasy Rider</h1><p>Hai una domanda? Il nostro team è a tua disposizione.</p>
      <p class="order-note">Vuoi ordinare il tuo kit? Compila il modulo di contatto. Ti risponderemo al più presto.</p>
      <p class="partner-note">Se sei un nostro concessionario o distributore, contattaci per conoscere le condizioni a te riservate. Puoi usare anche il modulo qui sotto.</p>
    </section>

    <section class="order-form" id="commande" aria-labelledby="order-form-title">
      <h2 id="order-form-title">Ordina o contattaci</h2>
      <p class="form-help">Usa questo modulo per domande, ordini o richieste professionali. Ti risponderemo al più presto.</p>
    <iframe
      src="https://tally.so/embed/X5ob7P"
      title="Contatta Weasy Rider"
      loading="lazy"
      style="display: block; width: 100%; height: 700px; border: 0;"
    ></iframe>
    </section>

    <div class="page-space"></div>
  </main>
</BaseLayout>

<style>
  .page-intro .partner-note {
    color: #73e69c;
    font-size: 20px;
    display: grid;
    place-items: center;
    min-height: 6rem;
    margin: 0;
    text-align: center;
  }

  .page-intro .contact-title {
    font-size: clamp(32px, 4.4vw, 54px);
  }

  .order-note {
    color: #ff5959;
  }

  @media (prefers-reduced-motion: no-preference) {
    .order-note {
      animation: order-note-blink 1.5s ease-in-out 10;
    }
  }

  @keyframes order-note-blink {
    50% { opacity: .5; }
  }
</style>
