---
import BaseLayout from '../../layouts/BaseLayout.astro';

const resources = [
  {
    "label": "Video di montaggio V100 / V100S (sottotitoli in italiano)",
    "href": "/videos/installation-v100s-it-sub.mp4",
    "image": "/installation/qr/video-v100-v100s-it.png"
  },
  {
    "label": "Video di montaggio V100 Stelvio (sottotitoli in italiano)",
    "href": "/videos/installation-stelvio-it-sub.mp4",
    "image": "/installation/qr/video-stelvio-it.png"
  },
  {
    "label": "Manuale di installazione V100 / V100S (PDF, italiano)",
    "href": "/NoticeMontageKIT_WR_V100S_IT.pdf",
    "image": "/installation/qr/notice-v100-v100s-it.png"
  },
  {
    "label": "Video sul funzionamento di WR / WAM (voce italiana)",
    "href": "/videos/warning-it-private.mp4",
    "image": "/installation/qr/video-wr-wam-it.png"
  },
  {
    "label": "Manuale di installazione V100 Stelvio (PDF, italiano)",
    "href": "/NoticeMontageKIT_WR_V100Stelvio_IT.pdf",
    "image": "/installation/qr/notice-stelvio-it.png"
  }
];
---
<BaseLayout lang="it" title="Installazione" description="Consulta i passaggi e i consigli per installare il tuo kit.">
  <main><section class="page-intro"><h1>Installazione</h1><p>Consulta i passaggi e i consigli per installare il tuo kit.</p><p><a href="/ManuelCompactWR_V100_IT.pdf">Apri il manuale di installazione rapida V100 in italiano (PDF)</a></p><p><a href="/ManuelCompactWR_V100Stelvio_IT.pdf">Apri il manuale compatto V100 Stelvio in italiano (PDF)</a></p></section>
    <section class="installation-video" aria-labelledby="installation-video-title">
      <h2 id="installation-video-title">Montaggio V100 / V100S — sottotitoli in italiano</h2>
      <video controls playsinline preload="metadata" width="854" height="564">
        <source src="/videos/installation-v100s-it-sub.mp4" type="video/mp4" />
      </video>
    </section>
    <section class="installation-resources" aria-labelledby="installation-resources">
      <h2 id="installation-resources">Video e manuali di installazione</h2>
      <ul>
        {resources.map(({ label, href, image }) => (
          <li>
            <a href={href}>
              <img src={image} alt="" width="180" loading="lazy" />
              <span>{label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <div class="page-space"></div></main>
</BaseLayout>


<style>
  .installation-video {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .installation-video video {
    display: block;
    width: 100%;
    max-width: 854px;
    height: auto;
    background: #000;
  }

  main a, main a:visited {
    color: #ff5959;
  }

  .installation-resources {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }
  a {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    gap: .75rem;
    padding: 1rem;
    border: 1px solid currentColor;
    border-radius: .5rem;
    text-align: center;
  }
  img {
    max-width: 100%;
    height: auto;
    background: white;
    padding: .25rem;
  }
</style>
