---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../../components/FaqList.astro';

const items = [
  {
    "question": "Warum hat Weasy Rider ein spezielles Kit für Moto Guzzi entwickelt?",
    "answer": "Wir fanden es nicht nachvollziehbar, dass so schöne Motorräder ab Werk ohne eine Sicherheitsfunktion auskommen müssen, die wir für absolut unverzichtbar halten und die bei anderen Modellen der Marke vorhanden ist. Aus dieser Überlegung entstand die Idee, ein spezielles Warnblink-Kit für eure Moto Guzzi zu entwickeln.",
    "highlight": "absolut unverzichtbar",
    "href": null,
    "linkLabel": null
  },
  {
    "question": "Warum ist Warnblinklicht bei Autos vorgeschrieben, aber nicht bei allen Motorrädern?",
    "answer": "In der Europäischen Union gelten für Autos und Motorräder unterschiedliche Typgenehmigungsregeln. Die Verordnung (EU) 2019/2144, insbesondere Anhang II, bildet den Rahmen für Autos. Für Motorräder stehen die Beleuchtungsanforderungen in der Delegierten Verordnung (EU) Nr. 3/2014, Anhang IX. In diesem Rahmen ist Warnblinklicht bei Autos vorgeschrieben, bleibt bei Motorrädern der Klasse L3e jedoch eine optionale Ausstattung.",
    "href": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32019R2144",
    "linkLabel": "Lesen : Verordnung (EU) 2019/2144 — Anhang II",
    "additionalLinks": [
      {
        "href": "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32014R0003",
        "label": "Lesen : Delegierte Verordnung (EU) Nr. 3/2014 — Anhang IX"
      }
    ]
  },
  {
    "question": "Wie bestelle ich mein Kit?",
    "answer": "Fülle das Kontaktformular aus und gib dein Motorradmodell an. Wir melden uns zeitnah, um deine Bestellung abzuschließen.",
    "href": "/de/contact/#haut-de-page",
    "linkLabel": "Bestellen oder Kontakt aufnehmen"
  },
  {
    "question": "Was kostet das Kit?",
    "answer": "Das komplette Kit für V100 Mandello oder V100 Stelvio inklusive Warnblink-Kontrollleuchte kostet 95 € zzgl. Versandkosten. Weitere Informationen findest du auf unserer Produktseite.",
    "href": "/de/produits/",
    "linkLabel": "Kits ansehen"
  },
  {
    "question": "Ist meine Moto Guzzi kompatibel?",
    "answer": "Die Kits sind für V100 Mandello und V100 Stelvio erhältlich. Das V7-Kit ist in Entwicklung. Kontaktiere uns, um dein Modell zu prüfen.",
    "href": "/de/compatibilite/",
    "linkLabel": "Kompatibilität prüfen"
  },
  {
    "question": "Muss die Fahrzeugelektrik verändert werden?",
    "answer": "Die modellspezifischen Kits für V100 Mandello und V100 Stelvio sind Plug-and-Play und rückrüstbar. Beim Einbau bleibt die Originalverkabelung unverändert.",
    "href": "/de/installation/",
    "linkLabel": "Einbauanleitungen ansehen"
  },
  {
    "question": "Wie schalte ich den Warnblinker ein und aus?",
    "answer": "Betätige einmal den linken oder rechten Blinker und drücke dann zügig die mittlere Taste zum Ausschalten des Blinkers. Wiederhole diese Bedienfolge, um den Warnblinker auszuschalten.",
    "href": "/de/",
    "linkLabel": "Demo auf der Startseite ausprobieren"
  },
  {
    "question": "Wann muss man in Frankreich den Warnblinker einschalten?",
    "answer": "In Frankreich schreibt Artikel R416-18 Warnblinklicht vor, wenn man vorübergehend erheblich langsamer fahren muss und dadurch andere Verkehrsteilnehmer überraschen könnte. In einer ununterbrochenen Fahrzeugkolonne gilt diese Pflicht nur für das letzte Fahrzeug.",
    "href": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000006842278",
    "linkLabel": "Artikel R416-18 auf Légifrance lesen"
  },
  {
    "question": "Welche Regeln gelten in Frankreich bei einem gefährlich liegen gebliebenen Fahrzeug?",
    "answer": "Artikel R416-19 verlangt Warnblinklicht und Warndreieck, wenn ein Fahrzeug auf der Fahrbahn ein Hindernis mit Gefahrenwirkung bildet. Absatz III nimmt motorisierte Zweiräder von dieser Pflicht aus. Absatz II schreibt bei einem Nothalt unter den dort genannten Bedingungen eine Warnweste vor.",
    "href": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000030582704",
    "linkLabel": "Artikel R416-19 lesen"
  },
  {
    "question": "Was passiert, wenn ich den Blinker benutze?",
    "answer": "Der Warnblinker wird während des Blinkens unterbrochen und nach dem Ausschalten des Blinkers automatisch wieder aktiviert.",
    "href": null,
    "linkLabel": null
  },
  {
    "question": "Wo finde ich Einbauanleitungen und Videos?",
    "answer": "Im Bereich Einbau findest du PDF-Anleitungen, Videos und die zugehörigen QR-Codes, die dich beim Einbau unterstützen.",
    "href": "/de/installation/",
    "linkLabel": "Anleitungen und Videos öffnen"
  },
  {
    "question": "Ist das WAM auch für andere Marken geeignet?",
    "answer": "Das WAM ist für Motorräder ohne Warnblinkanlage erhältlich. Für den Einbau sind dann Eingriffe in die Fahrzeugelektrik und gegebenenfalls ein zusätzlicher Schalter am Lenker erforderlich. Frag uns zu deinem Motorrad.",
    "href": "/de/contact/#haut-de-page",
    "linkLabel": "Eine Frage stellen"
  }
];
---
<BaseLayout lang="de" title="FAQ" description="Antworten auf häufige Fragen zu unseren Produkten.">
  <main>
    <section class="page-intro faq-intro">
      <h1>FAQ</h1>
      <p>Antworten auf häufige Fragen zu unseren Produkten.</p>
    </section>
    <FaqList items={items} />
  </main>
</BaseLayout>

<style>
  .page-intro.faq-intro {
    min-height: 0;
    padding-bottom: 40px;
  }
</style>
