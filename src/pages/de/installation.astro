---
import BaseLayout from '../../layouts/BaseLayout.astro';

const resources = [
  {
    "label": "Einbauvideo für V100 / V100S (deutsche Untertitel)",
    "href": "/videos/installation-v100s-de-sub.mp4",
    "image": "/installation/qr/video-v100-v100s-de.png"
  },
  {
    "label": "Einbauvideo für V100 Stelvio (deutsche Untertitel)",
    "href": "/videos/installation-stelvio-de-sub.mp4",
    "image": "/installation/qr/video-stelvio-de.png"
  },
  {
    "label": "Einbauanleitung für V100 / V100S (PDF, Deutsch)",
    "href": "/NoticeMontageKIT_WR_V100S_DE.pdf",
    "image": "/installation/qr/notice-v100-v100s-de-local.png"
  },
  {
    "label": "Funktionsweise von WR / WAM (deutsche Sprachfassung)",
    "href": "/videos/warning-de-private.mp4",
    "image": "/installation/qr/video-wr-wam-de.png"
  },
  {
    "label": "Einbauanleitung für V100 Stelvio (PDF, Deutsch)",
    "href": "/NoticeMontageKIT_WR_V100Stelvio_DE.pdf",
    "image": "/installation/qr/notice-stelvio-de-local.png"
  }
];
---
<BaseLayout lang="de" title="Einbau" description="Hier findest du Anleitungen und Tipps zum Einbau deines Kits.">
  <main><section class="page-intro"><h1>Einbau</h1><p>Hier findest du Anleitungen und Tipps zum Einbau deines Kits.</p><p><a href="/ManuelCompactWR_V100_DE.pdf">Kurzanleitung für den Einbau der V100 auf Deutsch öffnen (PDF)</a></p><p><a href="/ManuelCompactWR_V100Stelvio_DE.pdf">V100 Stelvio-Kurzanleitung auf Deutsch öffnen (PDF)</a></p></section>
    <section class="installation-video" aria-labelledby="installation-video-title"><h2 id="installation-video-title">Einbau an V100 / V100S — deutsche Untertitel</h2><video controls playsinline preload="metadata" width="854" height="564"><source src="/videos/installation-v100s-de-sub.mp4" type="video/mp4" /></video></section>
    <section class="installation-resources" aria-labelledby="installation-resources">
      <h2 id="installation-resources">Einbauvideos und Anleitungen</h2>
      <ul>
        {resources.map(({ label, href, image }) => (
          <li>
            <a href={href}>
              <img src={image} alt="" width="180" loading="lazy" />
              <span>{label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <div class="page-space"></div></main>
</BaseLayout>


<style>
  .installation-video { max-width: 72rem; margin: 0 auto; padding: 2rem 1rem; }
  .installation-video video { display: block; width: 100%; max-width: 854px; height: auto; background: #000; }
  main a, main a:visited {
    color: #ff5959;
  }

  .installation-resources {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }
  a {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    gap: .75rem;
    padding: 1rem;
    border: 1px solid currentColor;
    border-radius: .5rem;
    text-align: center;
  }
  img {
    max-width: 100%;
    height: auto;
    background: white;
    padding: .25rem;
  }
</style>
