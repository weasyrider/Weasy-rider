---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout lang="de" title="Kontakt" description="Du hast eine Frage? Unser Team hilft dir gerne.">
  <main><section class="page-intro"><h1 class="contact-title">Kontakt zu Weasy Rider</h1><p>Du hast eine Frage? Unser Team hilft dir gerne.</p>
<p class="partner-note">Unsere Händler und Vertriebspartner können über das folgende Formular ihre individuellen Konditionen anfragen.</p>
    </section>

    <section class="order-form" id="commande" aria-labelledby="order-form-title">
      <h2 id="order-form-title">Dein Kit bestellen</h2>
      <p class="order-note">Fülle dieses Formular aus, um dein Kit zu bestellen. Wir melden uns zeitnah, um deine Bestellung abzuschließen.</p>
    <iframe
      src="https://tally.so/embed/rDOZ8o"
      title="Kontakt zu Weasy Rider"
      loading="lazy"
      style="display: block; width: 100%; height: 700px; border: 0;"
    ></iframe>
    </section>

    <section class="legal-notice" aria-labelledby="legal-notice">
      <h2 id="legal-notice">Impressum</h2>
      <p><strong>Unternehmensangaben / Websitebetreiberin</strong> · Monique Petitjean EI</p>
      <p><strong>Geschäftsanschrift</strong> · 63 rue Pierre Jouhet, 93600 Aulnay-sous-Bois</p>
      <p><strong>Telefon</strong> · +33 6 83 73 14 56</p>
      <p><strong>E-Mail</strong> · contact@weasyrider.com</p>
      <p><strong>SIRET</strong> · 78990595700021</p>
      <p><strong>Unternehmensversicherung</strong> · MAAF, Vertrag MCE001</p>
      <p><strong>Hosting-Anbieter</strong> · Sevalla (Kinsta, Inc.)</p>
      <address>
        8605 Santa Monica Blvd #92581<br />
        West Hollywood, CA 90069, USA<br />
        <a href="tel:+18886102915">+1 (888) 610-2915</a><br />
        <a href="https://sevalla.com/contact/">Sevalla kontaktieren</a>
      </address>
    </section>
  </main>
</BaseLayout>

<style>
  .legal-notice {
    padding: 2rem 7%;
    line-height: 1.5;
  }

  .legal-notice h2 {
    margin: 0 0 .75rem;
    font-size: 1.25rem;
  }

  .legal-notice p {
    margin: .35rem 0;
  }

  .legal-notice address { font-style: normal; }
  .legal-notice a { color: inherit; }


  .page-intro .partner-note {
    color: #73e69c;
    font-size: 20px;
    display: grid;
    place-items: center;
    min-height: 6rem;
    margin: 0;
    text-align: center;
  }

  .page-intro .contact-title {
    font-size: clamp(32px, 4.4vw, 54px);
  }

  .order-note {
    color: #ff5959;
  }

  @media (prefers-reduced-motion: no-preference) {
    .order-note {
      animation: order-note-blink 1.5s ease-in-out 10;
    }
  }

  @keyframes order-note-blink {
    50% { opacity: .5; }
  }
</style>
