<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Bonjour !" />
    <title>Bonjour</title>
  </head>
  <body>
    <main>
      <img class="logo" src="/logo.svg" alt="Mon logo" />
      <h1>Bonjour</h1>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    color: #19231f;
    background: #f5f7f3;
    font-family: system-ui, sans-serif;
  }
  main { text-align: center; padding: 2rem; }
  .logo { display: block; width: min(220px, 60vw); height: 160px; object-fit: contain; margin: 0 auto 1.5rem; }
  h1 { margin: 0; font-size: clamp(2.5rem, 8vw, 5rem); letter-spacing: -0.06em; }
</style>
