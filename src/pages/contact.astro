---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Une question ? Notre équipe est à votre écoute.">
  <main><section class="page-intro contact-intro"><h1 class="contact-title">Contact Weasy Rider</h1><p>Une question ? Notre équipe est à votre écoute.</p>
      <p class="order-note">Vous souhaitez commander votre kit ? Merci de bien vouloir remplir le formulaire de contact. Nous vous répondrons très rapidement.</p>
      <p class="partner-note">Pour nos partenaires concessionnaires et distributeurs, contactez-nous pour connaître vos conditions particulières. Le formulaire est aussi à votre disposition.</p>
    </section>

    <section class="order-form" aria-label="Formulaire de contact et de commande">
    <iframe id="commande"
      src="https://tally.so/embed/4aJW5Y"
      title="Contacter Weasy Rider"
      loading="lazy"
      style="display: block; width: 100%; height: 700px; border: 0;"
    ></iframe>
    </section>

    <section class="legal-notice" aria-labelledby="legal-notice">
      <h2 id="legal-notice">Mentions légales</h2>
      <p><strong>Coordonnées de l’entreprise / éditeur du site</strong> · Monique Petitjean EI</p>
      <p><strong>Adresse de l’entreprise</strong> · 63 rue Pierre Jouhet, 93600 Aulnay-sous-Bois</p>
      <p><strong>Téléphone</strong> · +33 6 83 73 14 56</p>
      <p><strong>E-mail de contact</strong> · contact@weasyrider.com</p>
      <p><strong>SIRET</strong> · 78990595700021</p>
      <p><strong>Assurance de l’entreprise</strong> · MAAF, contrat MCE001</p>
      <p><strong>Hébergeur</strong> · Sevalla (Kinsta, Inc.)</p>
      <address>
        8605 Santa Monica Blvd #92581<br />
        West Hollywood, CA 90069, États-Unis<br />
        <a href="tel:+18886102915">+1 (888) 610-2915</a><br />
        <a href="https://sevalla.com/contact/">Contacter Sevalla</a>
      </address>
    </section>
  </main>
</BaseLayout>

<style>
  .page-intro.contact-intro {
    min-height: 0;
    padding-bottom: 32px;
  }

  .legal-notice {
    padding: 2rem 7%;
    line-height: 1.5;
  }

  .legal-notice h2 {
    margin: 0 0 .75rem;
    font-size: 1.25rem;
  }

  .legal-notice p {
    margin: .35rem 0;
  }

  .legal-notice address { font-style: normal; }
  .legal-notice a { color: inherit; }

  .page-intro .partner-note {
    color: #73e69c;
    font-size: 20px;
    display: grid;
    place-items: center;
    min-height: 0;
    margin: 20px 0 0;
    text-align: center;
  }

  .page-intro .contact-title {
    font-size: clamp(32px, 4.4vw, 54px);
  }

  .order-note {
    color: #ff5959;
  }

  @media (prefers-reduced-motion: no-preference) {
    .order-note, .partner-note {
      animation: order-note-blink 1.5s ease-in-out 10;
    }
  }

  @keyframes order-note-blink {
    50% { opacity: .5; }
  }
</style>
