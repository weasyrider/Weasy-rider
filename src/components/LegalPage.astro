---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { lang: string; title: string; intro: string; sections: string[][]; }
const {lang,title,intro,sections}=Astro.props;
---
<BaseLayout lang={lang} title={title} description={intro}>
  <main class="legal-page">
    <h1>{title}</h1><p class="intro">{intro}</p>
    {sections.map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}
    <ul class="references">
      <li><a href="https://tally.so/help/privacy-policy">Tally — Privacy policy</a></li>
      <li><a href="https://tally.so/help/gdpr">Tally — GDPR</a></li>
      <li><a href="https://tally.so/help/cookie-policy">Tally — Cookie policy</a></li>
      <li><a href="https://kinsta.com/legal/data-processing-addendum/">Kinsta — Data processing addendum</a></li>
      <li><a href="https://kinsta.com/legal/privacy-policy/">Kinsta — Privacy policy</a></li>
      <li><a href="https://www.cnil.fr/fr/adresser-une-plainte">CNIL</a></li>
    </ul>
  </main>
</BaseLayout>
<style>
.legal-page{max-width:1000px;margin:0 auto;padding:64px 28px 80px;line-height:1.8;color:#101a22}.legal-page h1{font-size:clamp(30px,4vw,44px);line-height:1.2;margin:0 0 24px}.intro{font-size:19px;color:#465159}.legal-page section{margin-top:32px}.legal-page h2{font-size:23px;margin:0 0 10px;line-height:1.3}.legal-page p{margin:0}.references{margin-top:36px;padding-left:20px}.references a{color:#a61223;text-underline-offset:3px}
</style>
